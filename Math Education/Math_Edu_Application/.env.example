# === MATH EDUCATION - Variables d'environnement ===
#
# Copiez ce fichier en .env.local et renseignez vos valeurs.
# .env.local est ignore par Git : aucune cle ne part sur le depot.
#
# Seules les variables prefixees VITE_ sont exposees au client (Vite).
# Ces deux valeurs sont publiques (protegees par les politiques RLS Supabase).
# NE JAMAIS mettre la cle service_role ici : elle reste cote serveur uniquement.
#
# Au deploiement : recopier ces memes variables dans les Variables
# d'environnement de Netlify / Vercel (source n1 de bugs si oublie).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optionnel. 'true' force les donnees factices meme si les cles ci-dessus sont
# renseignees. Utile pour une demonstration sans toucher aux vraies donnees.
VITE_USE_MOCK=

# === Cle SERVICE ROLE, usage LOCAL uniquement ===
#
# PAS de prefixe VITE_ : c'est volontaire et non negociable. Tout ce qui est
# prefixe VITE_ est embarque dans le JavaScript envoye au navigateur. Cette cle
# contourne TOUTES les politiques RLS : dans le bundle, elle donnerait a n'importe
# quel visiteur un acces total en lecture et en ecriture a la base.
#
# Elle ne sert qu'aux scripts locaux lances a la main :
#   npm run check:db      verification d'integration contre la vraie base
#   (sprint 3)            script de seed du contenu pedagogique
#
# Ou la trouver : Supabase > Project Settings > API > service_role (ou
# "secret key" dans la nouvelle interface). Ne jamais la committer, ne jamais la
# coller dans Netlify cote build client.

SUPABASE_SERVICE_ROLE_KEY=
