{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-education.fr/schemas/flashcards.schema.json",
  "title": "MATH EDUCATION - Cartes defi (recto et verso)",
  "description": "Cartes question-reponse d'une competence (sprint 2, point 4). L'eleve lit le recto, cherche de tete, retourne la carte et dit s'il savait. Pas de correction automatique : le verso n'est pas une cle a proteger. Ecrites par agents a partir des cartes mentales, relues comme les exercices.",
  "type": "object",
  "required": ["metadata", "flashcards"],
  "additionalProperties": false,

  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "total_flashcards"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        "scope": { "type": "string" },
        "updated_at": { "type": "string", "format": "date" },
        "total_flashcards": { "type": "integer", "minimum": 0 }
      }
    },

    "flashcards": {
      "type": "array",
      "items": { "$ref": "#/$defs/flashcard" }
    }
  },

  "$defs": {
    "flashcard": {
      "type": "object",
      "required": ["id", "skill_id", "recto", "verso", "review_status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FC-[A-P][0-9]{3}-[0-9]{2}$",
          "description": "FC - competence - numero. Ex. FC-C012-03."
        },
        "skill_id": { "type": "string", "pattern": "^[A-P][0-9]{3}$" },
        "recto": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Question courte, a laquelle on repond de tete en moins de 30 secondes. Markdown et KaTeX ($...$)."
        },
        "verso": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "La reponse, puis en une phrase le pourquoi ou la methode. Markdown et KaTeX."
        },
        "review_status": {
          "type": "string",
          "enum": ["brouillon", "relu_agent", "relu_humain", "valide"]
        }
      }
    }
  }
}
