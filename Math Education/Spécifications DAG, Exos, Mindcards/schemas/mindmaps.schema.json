{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-education.fr/schemas/mindmaps.schema.json",
  "title": "MATH EDUCATION - Cartes mentales",
  "description": "Contrat d'interface des cartes mentales (roadmap v2.0, section 1.3). La source est du Markdown hierarchique ; le rendu visuel est fait par l'application via Markmap, ce qui garantit une charte graphique homogene sans dessiner les cartes a la main.",
  "type": "object",
  "required": ["metadata", "mindmaps"],
  "additionalProperties": false,

  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "total_mindmaps"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        "scope": { "type": "string" },
        "updated_at": { "type": "string", "format": "date" },
        "total_mindmaps": { "type": "integer", "minimum": 0 }
      }
    },

    "mindmaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/mindmap" }
    }
  },

  "$defs": {
    "mindmap": {
      "type": "object",
      "required": ["id", "title", "domain", "skill_ids", "school_levels", "markdown", "review_status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MM-[A-O]-[0-9]{2}$",
          "description": "MM - lettre de domaine - numero. Ex. MM-C-01."
        },

        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Titre du chapitre couvert, affiche en tete de carte."
        },

        "domain": { "type": "string", "pattern": "^[A-O]$" },

        "skill_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Competences couvertes. Une carte porte un chapitre entier, pas une competence isolee : c'est ce qui la rend utile a la revision.",
          "items": { "type": "string", "pattern": "^[A-O][0-9]{3}$" }
        },

        "school_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["CP", "CE1", "CE2", "CM1", "CM2", "6e", "5e", "4e", "3e", "2nde", "1ere", "Terminale"]
          }
        },

        "markdown": {
          "type": "string",
          "minLength": 1,
          "description": "Contenu Markdown hierarchique consomme par Markmap. Un seul titre de niveau 1 (la notion centrale), puis des branches en niveau 2 et 3. Formules LaTeX entre $...$. Points essentiels en gras."
        },

        "review_status": {
          "type": "string",
          "enum": ["brouillon", "relu_agent", "relu_humain", "valide"]
        },

        "programme_ref": {
          "type": ["string", "null"],
          "description": "Attendus du programme officiel couverts par la carte."
        }
      }
    }
  }
}
